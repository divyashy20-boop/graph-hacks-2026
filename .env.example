# Compose is local-only by default; add keys before exposing the application.
UGI_API_KEYS=
UGI_BACKEND=falkordb
UGI_REDIS_URL=redis://127.0.0.1:6380/0
UGI_PROVIDER=offline
UGI_ALLOW_PAID_CALLS=false
# Experimental automatic immutable cards/provisional identity overlay; max200 mentions/upload.
# Does not merge facts or participate in definitive inference. Existing datasets are not backfilled.
UGI_IDENTITY_LEDGER=false
# F candidate assessment; requires ledger. No overlay corrections in this mode.
UGI_IDENTITY_RESOLUTION=off
# Separate opt-in AFTER testing dry runs. Only provisional overlays; original facts unchanged.
UGI_IDENTITY_AUTO_APPLY=false
# Operator trust boundary for EXCLUSIVE, stable namespaces. Ordinary uploads cannot set this.
UGI_IDENTITY_AUTHORITIES={}
UGI_IDENTITY_CANDIDATE_LIMIT=20
# Operator vocabulary registration only; not a trust or inference authorization.
UGI_SCHEMA_WRITES=false
# Bounded literal prose frames and provisional registry; never enables inference rules.
UGI_OPEN_PREDICATES=false
UGI_MODEL_ID=
# GroqCloud (explicit opt-in): UGI_PROVIDER=groq and model openai/gpt-oss-120b.
# Put GROQ_API_KEY only in an untracked .env/runtime secret; never in this file.
GROQ_API_KEY=
UGI_GROQ_REQUESTS_PER_MINUTE=30
UGI_GROQ_DAILY_REQUESTS=1000
UGI_GROQ_TOKENS_PER_MINUTE=8000
UGI_GROQ_DAILY_TOKENS=200000
UGI_GROQ_TIMEOUT_SECONDS=90
UGI_GROQ_SPLIT_MAX_OUTPUT_TOKENS=1550
# Optional zero-cloud-cost local model: UGI_PROVIDER=ollama and UGI_MODEL_ID=qwen3:4b-instruct
# Docker Desktop on Windows resolves host.docker.internal; avoid publicly exposing Ollama.
UGI_OLLAMA_URL=http://host.docker.internal:11434
UGI_AWS_REGION=us-east-1
# Verify current provider prices before opting in; dollars per million tokens.
# For Groq openai/gpt-oss-120b the documented list-price estimates are 0.15 / 0.60.
UGI_INPUT_PRICE=0
UGI_OUTPUT_PRICE=0
UGI_DAILY_COST_LIMIT=0.25
UGI_MAX_MODEL_CALLS=4
UGI_MAX_OUTPUT_TOKENS=1500
UGI_MAX_INPUT_TOKENS=12000
UGI_DAILY_AI_QUERIES=15
UGI_GLOBAL_DAILY_CALLS=100
# MCP: must be explicitly set to 1 before any MCP action writes data.
UGI_MCP_ALLOW_WRITES=0
UGI_MCP_OWNER=local-mcp
UGI_MCP_DATASET=demo

# Experimental guided agent and durable receipt memory (both required)
UGI_GUIDED_AGENT_ENABLED=false
UGI_MEMORY_ENABLED=false
# No external API or AWS side effects are enabled by these flags.
